# Backend environment configuration placeholder
PORT=8080
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bowol_db
DB_USER=bowol_app
DB_PASSWORD=bowol_secret

# Create local development keys in ../infra/secrets. They are never committed.
JWT_PUBLIC_KEY_PATH=file:../infra/secrets/jwt_public_key.pem
JWT_PRIVATE_KEY_PATH=file:../infra/secrets/jwt_private_key.pem
AI_DEFAULT_PROVIDER=mock
