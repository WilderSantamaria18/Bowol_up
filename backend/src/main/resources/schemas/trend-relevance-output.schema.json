{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrendRelevanceOutput",
  "type": "object",
  "required": ["score", "aiSummary"],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "aiSummary": {
      "type": "string",
      "minLength": 5
    },
    "strategicAlignment": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
