{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlannerBacklogOutput",
  "type": "object",
  "required": ["epic", "tasks"],
  "properties": {
    "epic": {
      "type": "object",
      "required": ["title", "objective"],
      "properties": {
        "title": { "type": "string" },
        "objective": { "type": "string" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "description", "priority", "estimateHours"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"]
          },
          "estimateHours": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 120.0
          },
          "status": {
            "type": "string",
            "enum": ["BACKLOG", "TODO"]
          },
          "category": { "type": "string" },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
